static func pick(room_type: int, rng: RandomNumberGenerator) -> Array:
	match room_type:
		FloorGenerator.RoomType.START:
			return START
		FloorGenerator.RoomType.TREASURE:
			return TREASURE
		FloorGenerator.RoomType.EXIT:
			return EXIT
		FloorGenerator.RoomType.BOSS:
			return BOSS
	return COMBAT[rng.randi_range(0, COMBAT.size() - 1)]
