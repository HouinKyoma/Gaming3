# --- Picking a layout ------------------------------------------------------------------

static func build(room_type: int, rng: RandomNumberGenerator, fd: FloorData) -> Array:
	match room_type:
		FloorGenerator.RoomType.START:
			return START
		FloorGenerator.RoomType.TREASURE:
			return TREASURE
		FloorGenerator.RoomType.BOSS:
			return _decorate(BOSS, rng, fd, 0.5)
	var size := _pick_size(rng, fd)
	if size == STANDARD and rng.randf() < 0.3:
		return _decorate(COMBAT[rng.randi_range(0, COMBAT.size() - 1)], rng, fd, 1.0)
	return generate(size, rng, fd)


static func _pick_size(rng: RandomNumberGenerator, fd: FloorData) -> Vector2i:
	if fd != null and rng.randf() < fd.big_room_chance:
		return BIG_SIZES[rng.randi_range(0, BIG_SIZES.size() - 1)]
	return STANDARD


## A hand-made layout with the floor's hazards sprinkled in.
static func _decorate(template: Array, rng: RandomNumberGenerator, fd: FloorData, amount: float) -> Array:
	for attempt in 20:
		var g := _to_grid(template)
		_hazards(g, rng, fd, amount)
		var reached := _reach(g)
		if reached.size() >= int(_count(g, PATHABLE) * 0.85) and _lanes_reached(g, reached):
			return _to_lines(g)
	return template


# --- Generator ---------------------------------------------------------------------------

## A random, mirrored layout of `size` (interior cells) with spawn points.
static func generate(size: Vector2i, rng: RandomNumberGenerator, fd: FloorData) -> Array:
	for attempt in 40:
		var g := _blank(size.x, size.y)
		_structure(g, rng, fd)
		_hazards(g, rng, fd, 1.0)
		var reached := _reach(g)
		if reached.size() >= int(_count(g, PATHABLE) * 0.85) and _lanes_reached(g, reached):
			_add_spawns(g, reached, rng)
			return _to_lines(g)
	var fallback := _blank(size.x, size.y)
	_add_spawns(fallback, _reach(fallback), rng)
	return _to_lines(fallback)


static func _structure(g: Array, rng: RandomNumberGenerator, fd: FloorData) -> void:
	var w := _w(g)
	var h := _h(g)
	var my := rng.randf() < 0.7
	match rng.randi_range(0, 6):
		0:  # pillar hall
			var sx := rng.randi_range(4, 6)
			var sy := rng.randi_range(3, 5)
			var ch := "P" if rng.randf() < 0.6 else "R"
			var y := rng.randi_range(2, sy)
			while y < h / 2:
				var x := rng.randi_range(2, sx)
				while x < w / 2:
					_put(g, x, y, ch, true, true)
					x += sx
				y += sy
		1:  # rock and crate clusters
			for i in maxi(3, w * h / 90):
				var cw := rng.randi_range(1, 3)
				var chh := rng.randi_range(1, 2)
				var x0 := rng.randi_range(1, w / 2 - 1)
				var y0 := rng.randi_range(1, h - 2)
				var ch := "C" if rng.randf() < 0.35 else "R"
				for dx in cw:
					for dy in chh:
						_put(g, x0 + dx, y0 + dy, ch, true, my)
		2:  # inner walls: half-corridors and alcoves
			for i in maxi(2, w * h / 150):
				if rng.randf() < 0.5:
					var y := rng.randi_range(2, h / 2 - 1)
					var x0 := rng.randi_range(2, maxi(2, w / 2 - 3))
					for dx in rng.randi_range(3, maxi(4, w / 4)):
						_put(g, x0 + dx, y, "#", true, true)
				else:
					var x := rng.randi_range(2, maxi(2, w / 2 - 2))
					var y0 := rng.randi_range(2, maxi(2, h / 2 - 1))
					for dy in rng.randi_range(2, maxi(3, h / 3)):
						_put(g, x, y0 + dy, "#", true, true)
		3:  # pit field
			for i in maxi(2, w * h / 110):
				_blob(g, rng, rng.randi_range(2, w / 2), rng.randi_range(2, h - 3), rng.randf_range(1.2, 3.2), "O", true, my)
		4:  # ring around the middle, open on all four sides
			var hw := maxi(3, w / 5)
			var hh := maxi(2, h / 5)
			var ch := "#" if rng.randf() < 0.5 else "R"
			var cx := w / 2
			var cy := h / 2
			for x in range(cx - hw, cx + hw):
				if absi(x - cx) > 1 and absi(x - cx + 1) > 1:
					_put(g, x, cy - hh, ch, false, false)
					_put(g, x, cy + hh - 1, ch, false, false)
			for y in range(cy - hh, cy + hh):
				if absi(y - cy) > 1 and absi(y - cy + 1) > 1:
					_put(g, cx - hw, y, ch, false, false)
					_put(g, cx + hw - 1, y, ch, false, false)
		5:  # river of pits (or lava) with bridges
			var fill := "~" if fd != null and fd.lava_chance > 0.3 else "O"
			if w >= h:
				var x0 := w / 2 - rng.randi_range(4, maxi(5, w / 4))
				for x in range(x0, x0 + 3):
					for y in h:
						if y % 5 > 1:
							_put(g, x, y, fill, true, false)
			else:
				var y0 := h / 2 - rng.randi_range(3, maxi(4, h / 4))
				for y in range(y0, y0 + 2):
					for x in w:
						if x % 6 > 1:
							_put(g, x, y, fill, false, true)
		_:  # open arena with a few pillars
			for i in rng.randi_range(2, 4):
				_put(g, rng.randi_range(3, w / 2 - 2), rng.randi_range(2, h / 2 - 1), "P", true, true)


static func _hazards(g: Array, rng: RandomNumberGenerator, fd: FloorData, amount: float) -> void:
	if fd == null:
		return
	var w := _w(g)
	var h := _h(g)
	var area := w * h
	if rng.randf() < fd.pit_chance * amount:
		for i in maxi(1, area / 170):
			_blob(g, rng, rng.randi_range(2, w - 3), rng.randi_range(2, h - 3), rng.randf_range(1.0, 2.4), "O", rng.randf() < 0.5, false)
	if rng.randf() < fd.spike_chance * amount:
		for i in maxi(1, area / 140):
			_blob(g, rng, rng.randi_range(2, w - 3), rng.randi_range(2, h - 3), rng.randf_range(0.8, 2.0), "^", false, false)
	if rng.randf() < fd.lava_chance * amount:
		for i in maxi(1, area / 150):
			_blob(g, rng, rng.randi_range(2, w - 3), rng.randi_range(2, h - 3), rng.randf_range(1.2, 2.8), "~", rng.randf() < 0.5, false)


static func _add_spawns(g: Array, reached: Dictionary, rng: RandomNumberGenerator) -> void:
	var w := _w(g)
	var h := _h(g)
	var doors := [Vector2i(w / 2, 0), Vector2i(w / 2, h - 1), Vector2i(0, h / 2), Vector2i(w - 1, h / 2)]
	var candidates: Array[Vector2i] = []
	for c: Vector2i in reached:
		if g[c.y][c.x] != ".":
			continue
		var near_door := false
		for d: Vector2i in doors:
			if absi(c.x - d.x) + absi(c.y - d.y) < 6:
				near_door = true
				break
		if not near_door:
			candidates.append(c)
	for i in range(candidates.size() - 1, 0, -1):
		var j := rng.randi_range(0, i)
		var tmp := candidates[i]
		candidates[i] = candidates[j]
		candidates[j] = tmp
	for i in mini(clampi(w * h / 40, 6, 14), candidates.size()):
		var c := candidates[i]
		g[c.y][c.x] = "S"


# --- Grid helpers --------------------------------------------------------------------------

static func _blank(w: int, h: int) -> Array:
	var g: Array = []
	for y in h:
		var row: Array = []
		row.resize(w)
		row.fill(".")
		g.append(row)
	return g


static func _to_grid(lines: Array) -> Array:
	var g: Array = []
	for line: String in lines:
		var row: Array = []
		for i in line.length():
			row.append(line[i])
		g.append(row)
	return g


static func _to_lines(g: Array) -> Array:
	var lines: Array = []
	for row: Array in g:
		lines.append("".join(PackedStringArray(row)))
	return lines


static func _w(g: Array) -> int:
	return (g[0] as Array).size()


static func _h(g: Array) -> int:
	return g.size()


## Door lanes and a small box in the middle (stairs, boss spawn) always stay floor.
static func _protected(x: int, y: int, w: int, h: int) -> bool:
	if x >= w / 2 - 2 and x <= w / 2 + 1 and (y <= 3 or y >= h - 4):
		return true
	if y >= h / 2 - 2 and y <= h / 2 + 1 and (x <= 3 or x >= w - 4):
		return true
	return absi(x - w / 2) <= 2 and absi(y - h / 2) <= 2


## Writes `ch` on a floor cell, mirrored left/right (mx) and/or top/bottom (my).
static func _put(g: Array, x: int, y: int, ch: String, mx: bool, my: bool) -> void:
	var w := _w(g)
	var h := _h(g)
	var cells := [Vector2i(x, y)]
	if mx:
		cells.append(Vector2i(w - 1 - x, y))
	if my:
		cells.append(Vector2i(x, h - 1 - y))
	if mx and my:
		cells.append(Vector2i(w - 1 - x, h - 1 - y))
	for c: Vector2i in cells:
		if c.x < 0 or c.y < 0 or c.x >= w or c.y >= h:
			continue
		if _protected(c.x, c.y, w, h) or g[c.y][c.x] != ".":
			continue
		g[c.y][c.x] = ch


static func _blob(g: Array, rng: RandomNumberGenerator, cx: int, cy: int, r: float, ch: String, mx: bool, my: bool) -> void:
	var ir := ceili(r)
	for dy in range(-ir, ir + 1):
		for dx in range(-ir, ir + 1):
			var d := (dx * dx) / (r * r) + (dy * dy) / (r * r * 0.7)
			if d <= 1.0 + rng.randf_range(-0.3, 0.15):
				_put(g, cx + dx, cy + dy, ch, mx, my)


static func _count(g: Array, chars: String) -> int:
	var n := 0
	for row: Array in g:
		for ch: String in row:
			if chars.contains(ch):
				n += 1
	return n


## Every cell reachable on foot (without stepping in lava or pits) from the top door.
static func _reach(g: Array) -> Dictionary:
	var w := _w(g)
	var h := _h(g)
	var start := Vector2i(w / 2, 0)
	var seen := {}
	if not PATHABLE.contains(g[start.y][start.x]):
		return seen
	seen[start] = true
	var queue: Array[Vector2i] = [start]
	while not queue.is_empty():
		var c: Vector2i = queue.pop_front()
		for d: Vector2i in [Vector2i.UP, Vector2i.DOWN, Vector2i.LEFT, Vector2i.RIGHT]:
			var n: Vector2i = c + d
			if n.x < 0 or n.y < 0 or n.x >= w or n.y >= h or seen.has(n):
				continue
			if PATHABLE.contains(g[n.y][n.x]):
				seen[n] = true
				queue.append(n)
	return seen


static func _lanes_reached(g: Array, reached: Dictionary) -> bool:
	var w := _w(g)
	var h := _h(g)
	return reached.has(Vector2i(w / 2, h - 1)) and reached.has(Vector2i(0, h / 2)) \
			and reached.has(Vector2i(w - 1, h / 2)) and reached.has(Vector2i(w / 2, h / 2))
